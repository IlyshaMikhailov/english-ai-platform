# PostgreSQL
POSTGRES_DB=english_platform
POSTGRES_USER=english_user
POSTGRES_PASSWORD=english_pass
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://english_user:english_pass@db:5432/english_platform
BACKEND_PORT=8000
JWT_SECRET_KEY=change-me-in-production-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Local Ollama on host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
